#!/bin/sh
# Enables and starts the timer, as debhelper does for the units it manages.
# Until the agent is enrolled, each run is skipped: the service needs
# /etc/bestbefore/agent.conf. A timer you disable stays disabled through
# upgrades, removal and reinstallation.
set -e

case "$1" in
configure | abort-upgrade | abort-deconfigure | abort-remove)
	systemd-sysusers bestbefore-agent.conf
	if command -v deb-systemd-helper >/dev/null; then
		# Only removes the mask "apt remove" left.
		deb-systemd-helper unmask bestbefore-agent.timer >/dev/null || true
		# was-enabled says yes on a first install, as nothing is recorded,
		# and otherwise whether the timer was enabled: an upgrade never turns
		# it on or off.
		if deb-systemd-helper --quiet was-enabled bestbefore-agent.timer; then
			deb-systemd-helper enable bestbefore-agent.timer >/dev/null || true
		else
			# Recorded, so that purging can clean up.
			deb-systemd-helper update-state bestbefore-agent.timer >/dev/null || true
		fi
	fi
	if [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null || true
		# deb-systemd-invoke leaves a disabled timer alone.
		if [ -n "$2" ]; then
			deb-systemd-invoke restart bestbefore-agent.timer >/dev/null || true
		else
			deb-systemd-invoke start bestbefore-agent.timer >/dev/null || true
		fi
	fi
	if [ "$1" = configure ] && [ ! -e /etc/bestbefore/agent.conf ]; then
		echo "Enrol this server with the code from the dashboard: sudo bestbefore-agent enrol bb1_…"
	fi
	;;
esac

exit 0
